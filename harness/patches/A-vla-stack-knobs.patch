+# Cosmos Policy (NVIDIA, nvidia-cosmos cookbook) x LIBERO — the WAM arm of the AMLC multi-model stack study (2026-10-15).
+# WAM = World Action Model: Cosmos-Predict2-2B video diffusion model post-trained to jointly decode
+# future frames + action chunk + value. One checkpoint covers spatial/object/goal/10 (paper avg 98.5%).
+# Official recipe = cosmos-policy LIBERO.md (flags reproduced verbatim in templates/cosmos-userdata.sh.j2).
+# Stack (from uv.lock @ 18a2acca): python 3.10 · torch 2.7.0+cu128 · MuJoCo 3.3.2 · libero 0.1.1 (PyPI) · numpy 2.2.6
+# · chunk 16 / replan 16 · step caps 220/280/300/520 · LIBERO fixed init states · seed 195 deterministic.
+# CLI: python deploy.py --vla cosmos --email YOU@example.com --region <r>
+model:
+  id: cosmos
+  hf_repo: nvidia/Cosmos-Policy-LIBERO-Predict2-2B
+  hf_model_revision: cb689ec0e3347c13667d70a78a3447388f5c3bb8
+  cosmos_repo: https://github.com/NVlabs/cosmos-policy.git
+  cosmos_commit: 18a2accadf4e7a3531e56754102af5a24d2316da
+  uv_version: 0.8.12
+  # official = gated hf://nvidia/Cosmos-Predict2-2B-Video2World (HF license click-through needed)
+  # wan_public = public Wan-AI/Wan2.1-T2V-1.3B Wan2.1_VAE.pth + skip training-only base load_path
+  tokenizer_source: official
+  wan_revision: 37ec512624d61f7aa208f7ea8140a131f93afc9a
+  chunk_size: 16
+  seed: 195
+instance:
+  ebs_gb: 250
+  creationpolicy_timeout: PT700M
+tasks:
+- suite: libero_spatial
+  num_trials_per_task: 5
+  condition: S0
+  description: libero_spatial S0
