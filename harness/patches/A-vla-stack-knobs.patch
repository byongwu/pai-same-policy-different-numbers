+"""run_libero_intervene_eval.py — H12 causal intervention on one embedding row.
+
+H9/H10/H11 narrowed the trigger to a single vocab entry (29889, "."): the same
+sentence with token 29892 (",") survives, and X-VLA — whose vocab has no 29889 —
+is unharmed. H11 then characterised that row observationally (lowest-norm in a
+61-entry punctuation population) but could not explain it, because in this
+checkpoint corpus frequency and embedding norm are confounded.
+
+Observation cannot separate them. This driver does, by editing the embedding
+matrix in memory and re-running the SAME cells:
+
+  arm A (control)  : weights untouched          -> reproduces H9
+  arm B (swap)     : rows 29889 <-> 29892        -> BIDIRECTIONAL. If the row owns
+                     the effect, "." becomes safe AND "," becomes lethal in one
+                     run. Frequency/position/tokenisation are all held fixed, so a
+                     double flip cannot be explained by them.
+  arm C (rescale)  : row 29889 scaled to the population median norm, direction
+                     kept -> isolates magnitude from direction.
+
+Why a swap rather than only a rescale: a rescale that revives "." is consistent
+with "any low-norm row is lethal", which H11 already falsified (row 856 has the
+same 0.0 percentile and survives at 0.969). The swap's second half — comma
+becoming lethal — is the half no magnitude story predicts.
+
+Design constraints, inherited from run_libero_lang_eval.py and extended:
+
+1. ZERO upstream diff. Rollout mechanics still come from upstream `run_episode`.
+2. Model loads ONCE; the intervention is applied to the loaded tensor, so all
+   three arms share one checkpoint load and one process.
+3. Scenes are keyed by (task_id, episode_idx) only -- never by arm or condition.
+4. The edit is AUDITED, not assumed. Every arm records a fingerprint of the rows
+   it actually ran with, computed after the edit. An intervention that silently
+   failed to apply would otherwise reproduce the control and read as "the row does
+   not matter" -- the exact false negative this experiment could produce.
+5. lm_head is a SEPARATE tensor in this checkpoint (verified in the safetensors
+   index: language_model.lm_head.weight and language_model.model.embed_tokens.weight
+   are distinct keys), so editing the input embedding does not perturb the output
+   head. The driver asserts that separateness at runtime rather than trusting it.
+"""
+
+import argparse
+import json
+import os
+import random
+import sys
+import time
+from typing import Any, Dict, List, Optional
+
+sys.path.append("../..")
+
+import numpy as np
+import torch
+from libero.libero import benchmark
+
+from experiments.robot.libero.run_libero_eval import (
+    GenerateConfig,
+    TASK_MAX_STEPS,
+    initialize_model,
+    run_episode,
+    validate_config,
+)
+from experiments.robot.libero.libero_utils import get_libero_env, save_rollout_video
+from experiments.robot.robot_utils import get_image_resize_size, set_seed_everywhere
+
+
+LEVELS = ("L1", "L1P", "L2", "L3")
+ARMS = ("control", "swap", "rescale")
+
+
+def find_embedding(model) -> torch.nn.Parameter:
+    """Locate the input embedding weight, and refuse to guess.
+
+    Returns the Parameter itself so callers edit the live tensor. Raising on a
+    miss matters more than a fallback: silently editing the wrong tensor produces
+    a run that looks like a clean null result.
+    """
+    for name, mod in model.named_modules():
+        if name.endswith("language_model.model.embed_tokens"):
+            return mod.weight
+    for name, p in model.named_parameters():
+        if name.endswith("language_model.model.embed_tokens.weight"):
+            return p
+    raise RuntimeError(
+        "could not locate language_model.model.embed_tokens; refusing to guess. "
+        f"candidates={[n for n, _ in model.named_parameters() if 'embed' in n][:8]}"
+    )
+
+
+def find_lm_head(model) -> Optional[torch.nn.Parameter]:
+    for name, p in model.named_parameters():
+        if name.endswith("language_model.lm_head.weight"):
+            return p
+    return None
+
+
+def row_fingerprint(weight: torch.Tensor, token_ids: List[int]) -> Dict[str, Any]:
+    """Norm + a few raw coordinates per row, as f64.
+
+    Norm alone cannot detect a swap between two rows of equal norm; the leading
+    coordinates can. Both are cheap and both go in the output file, so the audit
+    is reconstructible from the artifact without re-running the GPU.
+    """
+    out = {}
+    for tid in token_ids:
+        row = weight[tid].detach().to(torch.float32)
+        out[str(tid)] = {
+            "norm": float(torch.linalg.vector_norm(row).item()),
+            "head": [float(x) for x in row[:4].tolist()],
+        }
+    return out
+
+
+def population_median_norm(weight: torch.Tensor, population: List[int]) -> float:
+    norms = [
+        float(torch.linalg.vector_norm(weight[t].detach().to(torch.float32)).item())
+        for t in population
+    ]
+    return float(np.median(norms))
+
+
+def apply_intervention(
+    weight: torch.nn.Parameter,
+    arm: str,
+    killer: int,
+    survivor: int,
+    population: List[int],
+) -> Dict[str, Any]:
+    """Mutate `weight` in place for `arm`; return an audit record.
+
+    The audit record is built from the tensor AFTER the edit, so it reports what
+    the rollouts will actually see rather than what was intended.
+    """
+    before = row_fingerprint(weight, [killer, survivor])
+    detail: Dict[str, Any] = {"arm": arm, "before": before}
+
+    if arm == "control":
+        pass
+    elif arm == "swap":
+        with torch.no_grad():
+            tmp = weight[killer].detach().clone()
+            weight[killer] = weight[survivor].detach().clone()
+            weight[survivor] = tmp
+    elif arm == "rescale":
+        target = population_median_norm(weight, population)
+        with torch.no_grad():
+            row = weight[killer].detach().to(torch.float32)
+            cur = float(torch.linalg.vector_norm(row).item())
+            if cur == 0.0:
+                raise RuntimeError(f"row {killer} has zero norm; cannot rescale direction")
+            scaled = row * (target / cur)
+            weight[killer] = scaled.to(weight.dtype)
+        detail["target_norm"] = target
+        detail["source_norm"] = cur
+    else:
+        raise ValueError(f"unknown arm {arm!r}")
+
+    detail["after"] = row_fingerprint(weight, [killer, survivor])
+    return detail
+
+
+def verify_intervention(detail: Dict[str, Any], killer: int, survivor: int, dtype_eps: float) -> None:
+    """Fail loudly when the edit did not take.
+
+    This is the gate that stops the run from producing an uninterpretable null.
+    A no-op `swap` reproduces the control exactly, and every other check in the
+    pipeline would stay green while the headline read "the row is not causal".
+    """
+    arm = detail["arm"]
+    b, a = detail["before"], detail["after"]
+    k, s = str(killer), str(survivor)
+
+    def moved(x, y):
+        return abs(x["norm"] - y["norm"]) > dtype_eps or any(
+            abs(p - q) > dtype_eps for p, q in zip(x["head"], y["head"])
+        )
+
+    if arm == "control":
+        if moved(b[k], a[k]) or moved(b[s], a[s]):
+            raise RuntimeError("control arm mutated the embedding; run is not a control")
+        return
+
+    if arm == "swap":
+        if not moved(b[k], a[k]):
+            raise RuntimeError(f"swap arm: row {killer} unchanged -- intervention did not apply")
+        if not moved(b[s], a[s]):
+            raise RuntimeError(f"swap arm: row {survivor} unchanged -- intervention did not apply")
+        # A swap is not merely "both moved": each row must now hold the other's
+        # content. Checking that rules out a partial or aliased assignment.
+        if moved(a[k], b[s]) or moved(a[s], b[k]):
+            raise RuntimeError("swap arm: rows moved but do not hold each other's content")
+        return
+
+    if arm == "rescale":
+        if not moved(b[k], a[k]):
+            raise RuntimeError(f"rescale arm: row {killer} unchanged -- intervention did not apply")
+        if moved(b[s], a[s]):
+            raise RuntimeError(f"rescale arm: row {survivor} changed; only {killer} may move")
+        want = detail["target_norm"]
+        got = a[k]["norm"]
+        if abs(got - want) > max(1e-2 * want, 5 * dtype_eps):
+            raise RuntimeError(f"rescale arm: norm {got:.4f} != target {want:.4f}")
+        return
+
+    raise ValueError(f"unknown arm {arm!r}")
+
+
+def build_conditions(
+    stimuli: Dict[str, Any],
+    suite: str,
+    task_id: int,
+    original_from_env: str,
+    ops: List[str],
+    include_original: bool,
+) -> List[Dict[str, str]]:
+    """Resolve the instruction conditions, selected by operator name.
+
+    Selecting by explicit op list rather than by level: this experiment needs the
+    three cells that H9 already measured (control / period / comma) and nothing
+    else, because every extra cell multiplies by three arms.
+    """
+    entries = [e for e in stimuli.get(suite, []) if e["task_id"] == task_id]
+    if not entries:
+        raise KeyError(f"no stimuli for {suite} task_id={task_id}")
+    entry = entries[0]
+
+    if entry["original"] != original_from_env:
+        raise ValueError(
+            f"stimulus/benchmark mismatch for {suite} task_id={task_id}:\n"
+            f"  stimulus: {entry['original']!r}\n"
+            f"  env     : {original_from_env!r}"
+        )
+
+    by_op = {}
+    for level, variants in entry["variants"].items():
+        for v in variants:
+            by_op[v["op"]] = {"level": level, "text": v["text"]}
+
+    conditions: List[Dict[str, str]] = []
+    if include_original:
+        conditions.append({"cond_id": "original", "level": "L0", "op": "original", "text": entry["original"]})
+    missing = [o for o in ops if o not in by_op]
+    if missing:
+        raise KeyError(f"stimulus file lacks op(s) {missing} for {suite} task_id={task_id}")
+    for op in ops:
+        conditions.append({"cond_id": f"{by_op[op]['level']}/{op}", "level": by_op[op]["level"],
+                           "op": op, "text": by_op[op]["text"]})
+    return conditions
+
+
+def episode_seed(base_seed: int, task_id: int, episode_idx: int) -> int:
+    """Seed depends on the scene only -- not on arm, not on condition."""
+    return (base_seed * 1_000_003 + task_id * 1_009 + episode_idx) % (2**31 - 1)
+
+
+def main() -> int:
+    ap = argparse.ArgumentParser(description="H12: causal intervention on one embedding row")
+    ap.add_argument("--stimuli", required=True)
+    ap.add_argument("--pretrained-checkpoint", required=True)
+    ap.add_argument("--task-suite-name", required=True)
+    ap.add_argument("--out", required=True, help="JSONL output path (one row per episode)")
+    ap.add_argument("--num-trials-per-task", type=int, default=25)
+    ap.add_argument("--task-ids", default="", help="comma-separated subset")
+    ap.add_argument("--ops", default="l1p_period,l1p_comma",
+                    help="stimulus operators to run, besides the original control")
+    ap.add_argument("--arms", default="control,swap,rescale")
+    ap.add_argument("--killer-token", type=int, default=29889)
+    ap.add_argument("--survivor-token", type=int, default=29892)
+    ap.add_argument("--population-tokens", default="",
+                    help="comma-separated token ids defining the rescale target population")
+    ap.add_argument("--no-original", action="store_true")
+    ap.add_argument("--seed", type=int, default=7)
+    ap.add_argument("--center-crop", default="True")
+    ap.add_argument("--num-open-loop-steps", type=int, default=8)
+    ap.add_argument("--env-img-res", type=int, default=256)
+    ap.add_argument("--num-steps-wait", type=int, default=10)
+    ap.add_argument("--save-videos", default="failures", choices=["none", "failures", "all"])
+    ap.add_argument("--audit-out", default="", help="optional path for the intervention audit JSON")
+    ap.add_argument("--dry-run", action="store_true")
+    args = ap.parse_args()
+
+    arms = [a for a in args.arms.split(",") if a]
+    bad = [a for a in arms if a not in ARMS]
+    if bad:
+        print(f"[fatal] unknown arm(s): {bad}", file=sys.stderr)
+        return 2
+    if "control" not in arms:
+        # Without the untouched arm there is no in-run baseline, and a shifted
+        # baseline would make every intervention effect uninterpretable.
+        print("[fatal] the control arm is mandatory", file=sys.stderr)
+        return 2
+
+    ops = [o for o in args.ops.split(",") if o]
+    if not ops:
+        print("[fatal] --ops resolved to nothing", file=sys.stderr)
+        return 2
+    if args.killer_token == args.survivor_token:
+        print("[fatal] killer and survivor tokens must differ", file=sys.stderr)
+        return 2
+
+    population = [int(x) for x in args.population_tokens.split(",") if x != ""]
+    if "rescale" in arms and not population:
+        print("[fatal] --population-tokens required for the rescale arm", file=sys.stderr)
+        return 2
+    if args.killer_token in population:
+        # The target must be a property of the population, not of the row being
+        # moved; including it would drag the median toward the current value.
+        print("[fatal] killer token must not be in --population-tokens", file=sys.stderr)
+        return 2
+
+    with open(args.stimuli) as f:
+        stimuli = json.load(f)
+
+    cfg = GenerateConfig(
+        pretrained_checkpoint=args.pretrained_checkpoint,
+        task_suite_name=args.task_suite_name,
+        num_trials_per_task=args.num_trials_per_task,
+        center_crop=(str(args.center_crop).lower() == "true"),
+        num_open_loop_steps=args.num_open_loop_steps,
+        env_img_res=args.env_img_res,
+        num_steps_wait=args.num_steps_wait,
+        seed=args.seed,
+        use_wandb=False,
+        initial_states_path="DEFAULT",
+    )
+    validate_config(cfg)
+    if cfg.task_suite_name not in TASK_MAX_STEPS:
+        print(f"[fatal] no max-steps entry for suite {cfg.task_suite_name}", file=sys.stderr)
+        return 2
+    max_steps = TASK_MAX_STEPS[cfg.task_suite_name]
+
+    benchmark_dict = benchmark.get_benchmark_dict()
+    task_suite = benchmark_dict[cfg.task_suite_name]()
+    all_ids = list(range(task_suite.n_tasks))
+    task_ids = [int(x) for x in args.task_ids.split(",") if x != ""] or all_ids
+    unknown = [t for t in task_ids if t not in all_ids]
+    if unknown:
+        print(f"[fatal] task_ids not in suite: {unknown}", file=sys.stderr)
+        return 2
+
+    plan: Dict[int, List[Dict[str, str]]] = {}
+    for task_id in task_ids:
+        task = task_suite.get_task(task_id)
+        plan[task_id] = build_conditions(
+            stimuli, cfg.task_suite_name, task_id, task.language, ops,
+            include_original=not args.no_original,
+        )
+
+    n_cells = sum(len(v) for v in plan.values()) * len(arms)
+    n_eps = n_cells * cfg.num_trials_per_task
+    print(f"[plan] suite={cfg.task_suite_name} arms={arms} tasks={len(task_ids)} "
+          f"cells={n_cells} episodes={n_eps}")
+    for task_id in task_ids:
+        print(f"[plan] task {task_id}: {[c['cond_id'] for c in plan[task_id]]}")
+    print(f"[plan] intervention: killer={args.killer_token} survivor={args.survivor_token} "
+          f"population_n={len(population)}")
+    if args.dry_run:
+        print("[plan] dry-run: model not loaded, no rollouts executed")
+        return 0
+
+    model, action_head, proprio_projector, noisy_action_projector, processor = initialize_model(cfg)
+    resize_size = get_image_resize_size(cfg)
+
+    embed = find_embedding(model)
+    lm_head = find_lm_head(model)
+    if lm_head is not None and lm_head.data_ptr() == embed.data_ptr():
+        # Tied weights would make every edit hit the output head too, so the
+        # experiment would no longer be an input-embedding intervention.
+        print("[fatal] lm_head is tied to embed_tokens; this intervention would not be "
+              "confined to the input embedding", file=sys.stderr)
+        return 2
+    vocab_rows = int(embed.shape[0])
+    for tid in [args.killer_token, args.survivor_token] + population:
+        if not 0 <= tid < vocab_rows:
+            print(f"[fatal] token id {tid} out of range for embedding rows {vocab_rows}",
+                  file=sys.stderr)
+            return 2
+    print(f"[embed] rows={vocab_rows} dim={int(embed.shape[1])} dtype={embed.dtype} "
+          f"lm_head_separate={lm_head is not None}")
+
+    # Pristine copies of just the two rows: each arm starts from the checkpoint
+    # state rather than from the previous arm's edit, so arm order cannot leak.
+    pristine = {
+        args.killer_token: embed[args.killer_token].detach().clone(),
+        args.survivor_token: embed[args.survivor_token].detach().clone(),
+    }
+    dtype_eps = 1e-2 if embed.dtype in (torch.bfloat16, torch.float16) else 1e-6
+
+    os.makedirs(os.path.dirname(os.path.abspath(args.out)), exist_ok=True)
+    audits: List[Dict[str, Any]] = []
+    n_done = 0
+    t0 = time.time()
+
+    with open(args.out, "w") as out:
+        for arm in arms:
+            with torch.no_grad():
+                for tid, row in pristine.items():
+                    embed[tid] = row.clone()
+            detail = apply_intervention(embed, arm, args.killer_token, args.survivor_token, population)
+            verify_intervention(detail, args.killer_token, args.survivor_token, dtype_eps)
+            audits.append(detail)
+            print(f"[arm {arm}] intervention verified: "
+                  f"killer_norm {detail['before'][str(args.killer_token)]['norm']:.4f} -> "
+                  f"{detail['after'][str(args.killer_token)]['norm']:.4f} · "
+                  f"survivor_norm {detail['before'][str(args.survivor_token)]['norm']:.4f} -> "
+                  f"{detail['after'][str(args.survivor_token)]['norm']:.4f}")
+
+            for task_id in task_ids:
+                initial_states = task_suite.get_task_init_states(task_id)
+                task = task_suite.get_task(task_id)
+                env, env_task_description = get_libero_env(task, cfg.model_family,
+                                                           resolution=cfg.env_img_res)
+                for cond in plan[task_id]:
+                    for episode_idx in range(cfg.num_trials_per_task):
+                        s = episode_seed(cfg.seed, task_id, episode_idx)
+                        set_seed_everywhere(s)
+                        random.seed(s)
+                        np.random.seed(s)
+
+                        success, replay_images = run_episode(
+                            cfg, env, cond["text"], model, resize_size, processor,
+                            action_head, proprio_projector, noisy_action_projector,
+                            initial_states[episode_idx], None,
+                        )
+                        steps = len(replay_images)
+                        row = {
+                            "suite": cfg.task_suite_name,
+                            "task_id": task_id,
+                            "env_task_description": env_task_description,
+                            "arm": arm,
+                            "cond_id": cond["cond_id"],
+                            "level": cond["level"],
+                            "op": cond["op"],
+                            "instruction": cond["text"],
+                            "episode_idx": episode_idx,
+                            "episode_seed": s,
+                            "success": bool(success),
+                            "steps": steps,
+                            "hit_step_cap": (not success) and steps >= max_steps,
+                            "max_steps": max_steps,
+                            # Per-row provenance of the weights actually in use, so
+                            # the artifact alone proves which arm each episode ran
+                            # under -- the arm label by itself is just a string.
+                            "killer_token": args.killer_token,
+                            "survivor_token": args.survivor_token,
+                            "killer_norm": detail["after"][str(args.killer_token)]["norm"],
+                            "survivor_norm": detail["after"][str(args.survivor_token)]["norm"],
+                        }
+                        out.write(json.dumps(row) + "\n")
+                        out.flush()
+
+                        keep = args.save_videos == "all" or (args.save_videos == "failures" and not success)
+                        if keep:
+                            tag = f"{arm}-{task_id}-{cond['cond_id'].replace('/', '_')}"
+                            save_rollout_video(replay_images, n_done, success=success,
+                                               task_description=tag, log_file=None)
+
+                        n_done += 1
+                        if n_done % 10 == 0:
+                            rate = (time.time() - t0) / n_done
+                            print(f"[prog] {n_done}/{n_eps} eps  {rate:.1f}s/ep  "
+                                  f"eta {(n_eps - n_done) * rate / 60:.0f}m")
+                env.close()
+
+    audit_path = args.audit_out or (os.path.splitext(args.out)[0] + "-audit.json")
+    with open(audit_path, "w") as f:
+        json.dump({
+            "killer_token": args.killer_token,
+            "survivor_token": args.survivor_token,
+            "population_tokens": population,
+            "embed_tensor_rows": vocab_rows,
+            "embed_dtype": str(embed.dtype),
+            "lm_head_separate": lm_head is not None,
+            "arms": audits,
+        }, f, indent=2)
+    print(f"[done] {n_done} episodes -> {args.out} in {(time.time() - t0) / 60:.1f}m")
+    print(f"[done] intervention audit -> {audit_path}")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
