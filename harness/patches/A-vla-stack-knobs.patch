+++ b/templates/cosmos-userdata.sh.j2
@@ -0,0 +1,235 @@
+#!/bin/bash
+# Cosmos Policy (NVIDIA WAM, Cosmos-Predict2-2B post-trained) x LIBERO — official eval, local mode
+# Checkpoint: {{ hf_repo }} (rev {{ hf_model_revision[:8] }})   Code: {{ cosmos_repo }} @ {{ cosmos_commit[:8] }}
+# Generated by vla-simulator/generate.py --vla cosmos (AMLC multi-model stack study, 2026-10-15)
+# Official recipe = LIBERO.md: `uv sync --extra cu128 --group libero --python 3.10` +
+#   run_libero_eval --config cosmos_predict2_2b_480p_libero__inference_only (flags copied verbatim below).
+# tokenizer_source: official = hf://nvidia/Cosmos-Predict2-2B-Video2World (gated) ·
+#   wan_public = Wan-AI/Wan2.1-T2V-1.3B Wan2.1_VAE.pth (same VAE family, public) + skip the
+#   training-only base-model load_path. Recorded in summary.txt either way.
+set -euo pipefail
+
+COSMOS_DIR=/home/ubuntu/cosmos-policy
+VIDEO_BASE_DIR=/tmp/cosmos-videos
+RUN_ID=$(date '+%Y-%m-%d-%H%M')
+S3_BUCKET="${S3BucketName}"
+SNS_TOPIC_ARN="${SnsTopicArn}"
+STACK_NAME="${StackName}"
+WAIT_CONDITION_URL="${WaitConditionUrl}"
+REGION="${Region}"
+AUTO_TERMINATE="${AutoTerminate}"
+export HOME=/root
+export HF_HOME=/home/ubuntu/.cache/huggingface
+export UV_CACHE_DIR=/home/ubuntu/.cache/uv
+export UV_PYTHON_INSTALL_DIR=/home/ubuntu/.uv-python
+export MUJOCO_GL=egl PYOPENGL_PLATFORM=egl
+LOGF=/var/log/cosmos-userdata.log
+log() { echo "[COSMOS] $(date '+%H:%M:%S') $*" | tee -a $LOGF; }
+
+cfn_signal() {
+    local _status; [ "$1" -eq 0 ] && _status="SUCCESS" || _status="FAILURE"
+    local _t _iid
+    _t=$(curl -s -X PUT "http://169.254.169.254/latest/api/token" -H "X-aws-ec2-metadata-token-ttl-seconds: 60" 2>/dev/null || echo "")
+    _iid=$(curl -s -H "X-aws-ec2-metadata-token: $_t" "http://169.254.169.254/latest/meta-data/instance-id" 2>/dev/null || echo "i-unknown")
+    curl -s -X PUT -H 'Content-Type:' --data-binary \
+        "{\"Status\":\"${_status}\",\"Reason\":\"Script exit\",\"UniqueId\":\"${_iid}\",\"Data\":\"${_status}\"}" \
+        "$WAIT_CONDITION_URL" >> $LOGF 2>&1 && log "cfn_signal $_status sent" || log "[warn] cfn_signal failed"
+}
+upload_diag() { aws s3 cp $LOGF "s3://${S3_BUCKET}/${RUN_ID}/userdata.log" --region "$REGION" >/dev/null 2>&1 || true; }
+die() { log "ERROR: $*"; upload_diag; cfn_signal 1; exit 1; }
+_trap_sent=false
+trap 'if [ "$_trap_sent" = false ]; then _trap_sent=true; log "ERROR: abnormal exit (line ${LINENO})"; upload_diag; cfn_signal 1; fi' ERR
+
+log "===== Cosmos Policy UserData start (RUN_ID: ${RUN_ID}) ====="
+META_TOKEN=$(curl -s -X PUT "http://169.254.169.254/latest/api/token" -H "X-aws-ec2-metadata-token-ttl-seconds: 60" 2>/dev/null || echo "")
+INSTANCE_ID=$(curl -s -H "X-aws-ec2-metadata-token: $META_TOKEN" "http://169.254.169.254/latest/meta-data/instance-id" 2>/dev/null || echo unknown)
+INSTANCE_TYPE=$(curl -s -H "X-aws-ec2-metadata-token: $META_TOKEN" "http://169.254.169.254/latest/meta-data/instance-type" 2>/dev/null || echo unknown)
+log "  Instance: ${INSTANCE_ID} (${INSTANCE_TYPE})"
+
+# ── [1/6] System packages (same apt-lock handling as the other study templates) ──
+log "[1/6] Installing system packages..."
+export DEBIAN_FRONTEND=noninteractive
+systemctl stop unattended-upgrades apt-daily.service apt-daily-upgrade.service apt-daily.timer apt-daily-upgrade.timer 2>/dev/null || true
+systemctl mask unattended-upgrades apt-daily.service apt-daily-upgrade.service 2>/dev/null || true
+pkill -9 -f "unattended-upgrade" 2>/dev/null || true; pkill -9 -f "apt-get" 2>/dev/null || true; sleep 5
+rm -f /var/lib/dpkg/lock-frontend /var/lib/dpkg/lock /var/lib/apt/lists/lock 2>/dev/null || true
+dpkg --configure -a >/dev/null 2>&1 || true
+for i in 1 2 3; do apt-get update -qq -o DPkg::Lock::Timeout=300 >> $LOGF 2>&1 && break; [ $i = 3 ] && die "apt-get update failed"; sleep 30; done
+for i in 1 2 3; do
+    apt-get install -y --no-install-recommends -o DPkg::Lock::Timeout=300 \
+        git git-lfs curl ca-certificates awscli jq ffmpeg build-essential cmake \
+        libgl1 libegl1 libegl1-mesa-dev libgl1-mesa-dri libgles2 libglib2.0-0 libsm6 libxext6 libxrender1 \
+        >> $LOGF 2>&1 && break
+    [ $i = 3 ] && die "apt-get install failed"; pkill -9 -f unattended-upgrade || true; sleep 30
+done
+
+# ── [2/6] GPU driver: torch 2.7.0+cu128 needs driver >= 570 ──
+log "[2/6] Checking GPU driver..."
+nvidia-smi -L | tee -a $LOGF || die "nvidia-smi failed"
+DRV=$(nvidia-smi --query-gpu=driver_version --format=csv,noheader | head -1)
+log "  driver ${DRV}"
+[ "${DRV%%.*}" -ge 570 ] || die "driver ${DRV} < 570 (CUDA 12.8 wheels will not run)"
+nvidia-smi --query-gpu=name,memory.total --format=csv | tee -a $LOGF
+
+# ── [3/6] Clone + uv sync (official) ──
+log "[3/6] Cloning {{ cosmos_repo }} @ {{ cosmos_commit[:8] }}..."
+curl -LsSf https://astral.sh/uv/{{ uv_version }}/install.sh | env UV_INSTALL_DIR=/usr/local/bin sh >> $LOGF 2>&1 || die "uv install failed"
+git clone -q {{ cosmos_repo }} "$COSMOS_DIR" || die "clone failed"
+cd "$COSMOS_DIR"; git checkout -q {{ cosmos_commit }} || die "checkout failed"
+log "[3/6] uv sync --extra cu128 --group libero --python 3.10 (~15 min)..."
+for i in 1 2; do
+    uv sync --extra cu128 --group libero --python 3.10 >> /tmp/cosmos_uvsync.log 2>&1 && break
+    [ $i = 2 ] && { tail -40 /tmp/cosmos_uvsync.log >> $LOGF; aws s3 cp /tmp/cosmos_uvsync.log "s3://${S3_BUCKET}/${RUN_ID}/uvsync.log" --region "$REGION" || true; die "uv sync failed"; }
+    log "  [warn] uv sync failed once, retrying"; sleep 20
+done
+PY="uv run --extra cu128 --group libero --python 3.10 python"
+$PY - <<'VEOF' 2>&1 | tee -a $LOGF
+import importlib.metadata as m
+for p in ["torch","mujoco","robosuite","libero","numpy","transformer-engine","flash-attn"]:
+    try: print(f"  pkg {p}=={m.version(p)}")
+    except Exception as e: print(f"  pkg {p} MISSING {e}")
+import torch; print("  cuda", torch.version.cuda, torch.cuda.is_available(), torch.cuda.get_device_name(0))
+VEOF
+
+# LIBERO (PyPI) asks for a config path on first import when ~/.libero/config.yaml is absent -> pre-create.
+LIBERO_PKG_DIR=$($PY -c "import importlib.util,os; s=importlib.util.find_spec('libero'); print(os.path.join(list(s.submodule_search_locations)[0],'libero'))")
+mkdir -p /root/.libero
+cat > /root/.libero/config.yaml <<LCFG
+assets: ${LIBERO_PKG_DIR}/assets
+bddl_files: ${LIBERO_PKG_DIR}/bddl_files
+benchmark_root: ${LIBERO_PKG_DIR}
+datasets: ${LIBERO_PKG_DIR}/../datasets
+init_states: ${LIBERO_PKG_DIR}/init_files
+LCFG
+log "  LIBERO config -> ${LIBERO_PKG_DIR}"
+[ -d "${LIBERO_PKG_DIR}/init_files" ] || die "LIBERO init_files missing under ${LIBERO_PKG_DIR}"
+
+# ── [4/6] Weights ──
+log "[4/6] HF token + weights..."
+HF_TOKEN=$(aws ssm get-parameter --name "/vla-simulator/hf-token" --with-decryption --query 'Parameter.Value' --output text --region "$REGION" 2>/dev/null || echo "")
+[ -n "$HF_TOKEN" ] && export HF_TOKEN HUGGING_FACE_HUB_TOKEN="$HF_TOKEN" && log "  HF token loaded"
+$PY - <<PEOF 2>&1 | tee -a $LOGF || die "policy checkpoint download failed"
+from huggingface_hub import snapshot_download
+print("  policy ckpt ->", snapshot_download("{{ hf_repo }}", revision="{{ hf_model_revision }}"))
+PEOF
