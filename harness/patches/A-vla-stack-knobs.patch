+        "'"${WAIT_CONDITION_URL}"'" >/dev/null 2>&1 || true
+    aws ec2 terminate-instances --instance-ids '"${INSTANCE_ID}"' --region '"${REGION}"' \
+        >> /var/log/openvla-oft-userdata.log 2>&1
