+        [ -s "$_f" ] || continue
+        echo "[OFT] [watchdog] rescuing $_f ($(wc -l < "$_f") rows)" \
+            >> /var/log/openvla-oft-userdata.log
+        aws s3 cp "$_f" \
+            "s3://'"${S3_BUCKET}"'/'"${RUN_ID}"'/watchdog-rescue/$(basename "$_f")" \
+            --region '"${REGION}"' >> /var/log/openvla-oft-userdata.log 2>&1 || true
+    done
+    if [ -s /home/ubuntu/lang-stimuli.json ]; then
+        aws s3 cp /home/ubuntu/lang-stimuli.json \
+            "s3://'"${S3_BUCKET}"'/'"${RUN_ID}"'/watchdog-rescue/lang-stimuli.json" \
+            --region '"${REGION}"' >> /var/log/openvla-oft-userdata.log 2>&1 || true
+    fi
+    aws s3 cp /var/log/openvla-oft-userdata.log \
