+def _generate_asis_tier1(vla: str, config: dict, extra_keys: tuple) -> str:
+    """Shared renderer for AS-IS TIER 1 adapters (spatialvla, rdt1b).
+
+    Tier 1 wires a PUBLIC checkpoint exactly as the vendor documents and measures the result.
+    For both of these models the vendor documents no LIBERO path at all, so the rendered userdata
+    proves the environment (ckpt downloads, model/config loads, LIBERO imports) and then emits a
+    structured NOT-EVALUABLE record instead of inventing the undocumented inputs. Full evidence:
+    the AS-IS FINDING blocks in models/<vla>.yaml.
+
+    Every context value is READ from models/<vla>.yaml — nothing is inferred here.
+    """
+    tasks = config.get("tasks", [])
+    if not tasks:
+        print(f"[error] models/{vla}.yaml에 tasks 항목이 없습니다.", file=sys.stderr)
+        sys.exit(1)
+
+    model = config.get("model", {})
+    revision = model.get("hf_model_revision", "")
+    if not revision:
+        # Unpinned forbids any reproducibility claim — refuse at generate time, not on a paid GPU.
+        print(f"[error] models/{vla}.yaml: hf_model_revision must be pinned (got empty).",
+              file=sys.stderr)
+        sys.exit(1)
+
+    ctx = {
+        "tasks_json": _tasks_json_for_bash(tasks),
+        "deployment": config.get("deployment", {}),
+        "hf_repo": model.get("hf_repo", ""),
+        "hf_model_revision": revision,
+        "python_version": model.get("python_version", "3.10"),
+        "libero_commit": model.get("libero_commit", ""),
+    }
+    for key in extra_keys:
+        ctx[key] = model.get(key, "")
+
+    env = Environment(loader=FileSystemLoader(str(TEMPLATES_DIR)), keep_trailing_newline=True)  # nosec B701 - shell script template
+    return env.get_template(f"{vla}-userdata.sh.j2").render(**ctx)
