@@ -0,0 +1,266 @@
+"""
+run_libero_lang_eval.py — P1 prompt-sensitivity driver for LIBERO.
+
+Holds the goal fixed and varies ONLY the instruction string fed to the policy.
+Drop this next to upstream run_libero_eval.py (experiments/robot/libero/) and run
+from the openvla-oft repo root, exactly like upstream.
+
+Design constraints this file exists to satisfy:
+
+1. ZERO upstream diff. Rollout mechanics come from upstream `run_episode` by
+   import, so the original-instruction condition is not a re-implementation of
+   the baseline -- it IS the baseline code path. A positive control that
+   reproduces published SR therefore validates the whole stack, not just ours.
+2. Model loads ONCE for all conditions. Upstream's entry point loads a 7B
+   checkpoint per process; a sweep over N instructions would pay that N times.
+3. Initial states are keyed by task_id + episode_idx (upstream DEFAULT path), so
+   every condition sees the identical scene sequence. Paired comparison is what
+   makes a small n informative.
+4. Scoring never sees the instruction. Success comes from env.step's `done`
+   inside upstream run_episode. The success predicate is a property of the BDDL
+   goal, which we do not touch.
+"""
+
+import argparse
+import json
+import os
+import random
+import sys
+import time
+from typing import Any, Dict, List, Optional
+
+# Upstream expects to be launched from the openvla-oft repo root; mirror the
+# sys.path fixup it does at import time so `experiments.*` resolves either way.
+sys.path.append("../..")
+
+import numpy as np
+from libero.libero import benchmark
+
+from experiments.robot.libero.run_libero_eval import (
+    GenerateConfig,
+    TASK_MAX_STEPS,
+    initialize_model,
+    run_episode,
+    validate_config,
+)
+from experiments.robot.libero.libero_utils import get_libero_env, save_rollout_video
+from experiments.robot.robot_utils import get_image_resize_size, set_seed_everywhere
+
+
+LEVELS = ("L1", "L1P", "L2", "L3")
+
+
+def build_conditions(
+    stimuli: Dict[str, Any],
+    suite: str,
+    task_id: int,
+    original_from_env: str,
+    levels: List[str],
+    include_original: bool,
+    include_empty: bool,
+    max_per_level: Optional[int],
+) -> List[Dict[str, str]]:
+    """Resolve the instruction conditions for one task, in a fixed order.
+
+    Raises on a stimulus/benchmark mismatch rather than silently substituting the
+    environment's own sentence -- a wrong-task instruction would look like a
+    dramatic language effect while actually measuring a lookup bug.
+    """
+    entries = [e for e in stimuli.get(suite, []) if e["task_id"] == task_id]
+    if not entries:
+        raise KeyError(f"no stimuli for {suite} task_id={task_id}")
+    entry = entries[0]
+
+    if entry["original"] != original_from_env:
+        raise ValueError(
+            f"stimulus/benchmark mismatch for {suite} task_id={task_id}:\n"
+            f"  stimulus: {entry['original']!r}\n"
+            f"  env     : {original_from_env!r}"
+        )
+
+    conditions: List[Dict[str, str]] = []
+    if include_original:
+        conditions.append({"cond_id": "original", "level": "L0", "op": "original", "text": entry["original"]})
+    if include_empty:
+        conditions.append({"cond_id": "empty", "level": "L0", "op": "empty", "text": entry["empty"]})
+    for level in levels:
+        variants = entry["variants"].get(level, [])
+        if max_per_level is not None:
+            variants = variants[:max_per_level]
+        for v in variants:
+            conditions.append(
+                {"cond_id": f"{level}/{v['op']}", "level": level, "op": v["op"], "text": v["text"]}
+            )
+    return conditions
+
+
+def episode_seed(base_seed: int, task_id: int, episode_idx: int) -> int:
+    """Seed depends on the scene, never on the instruction condition.
+
+    If the seed advanced with condition order, condition 12 would face different
+    stochasticity than condition 1 and the between-condition contrast would
+    absorb RNG drift.
+    """
+    return (base_seed * 1_000_003 + task_id * 1_009 + episode_idx) % (2**31 - 1)
+
+
+def main() -> int:
+    ap = argparse.ArgumentParser(description="LIBERO prompt-sensitivity sweep (goal fixed, wording varied)")
+    ap.add_argument("--stimuli", required=True, help="prompts-v1.json")
+    ap.add_argument("--pretrained-checkpoint", required=True)
+    ap.add_argument("--task-suite-name", required=True)
+    ap.add_argument("--out", required=True, help="JSONL output path (one row per episode)")
+    ap.add_argument("--num-trials-per-task", type=int, default=25)
+    ap.add_argument("--task-ids", default="", help="comma-separated subset, e.g. 0,1 (default: all)")
+    ap.add_argument("--levels", default="L1", help="comma-separated subset of L1,L1P,L2,L3")
+    ap.add_argument("--max-per-level", type=int, default=None)
+    ap.add_argument("--no-original", action="store_true", help="skip the positive control")
+    ap.add_argument("--no-empty", action="store_true", help="skip the empty-instruction control")
+    ap.add_argument("--seed", type=int, default=7)
+    ap.add_argument("--center-crop", default="True")
+    ap.add_argument("--num-open-loop-steps", type=int, default=8)
+    ap.add_argument("--env-img-res", type=int, default=256)
+    ap.add_argument("--num-steps-wait", type=int, default=10)
+    ap.add_argument("--save-videos", default="failures", choices=["none", "failures", "all"])
+    ap.add_argument("--dry-run", action="store_true", help="resolve conditions and exit without loading the model")
+    args = ap.parse_args()
+
+    levels = [x for x in args.levels.split(",") if x]
+    bad = [x for x in levels if x not in LEVELS]
+    if bad:
+        print(f"[fatal] unknown level(s): {bad}", file=sys.stderr)
+        return 2
+
+    with open(args.stimuli) as f:
+        stimuli = json.load(f)
+
+    cfg = GenerateConfig(
+        pretrained_checkpoint=args.pretrained_checkpoint,
+        task_suite_name=args.task_suite_name,
+        num_trials_per_task=args.num_trials_per_task,
+        center_crop=(str(args.center_crop).lower() == "true"),
+        num_open_loop_steps=args.num_open_loop_steps,
+        env_img_res=args.env_img_res,
+        num_steps_wait=args.num_steps_wait,
+        seed=args.seed,
+        use_wandb=False,
+        # Pinned, not merely defaulted: any other value makes upstream key initial
+        # states by the instruction string itself, which KeyErrors the moment we
+        # override it -- and would otherwise silently change scenes per condition.
+        initial_states_path="DEFAULT",
+    )
+    validate_config(cfg)
+    if cfg.task_suite_name not in TASK_MAX_STEPS:
+        print(f"[fatal] no max-steps entry for suite {cfg.task_suite_name}", file=sys.stderr)
+        return 2
+    max_steps = TASK_MAX_STEPS[cfg.task_suite_name]
+
+    benchmark_dict = benchmark.get_benchmark_dict()
+    task_suite = benchmark_dict[cfg.task_suite_name]()
+    all_ids = list(range(task_suite.n_tasks))
+    task_ids = [int(x) for x in args.task_ids.split(",") if x != ""] or all_ids
+    unknown = [t for t in task_ids if t not in all_ids]
+    if unknown:
+        print(f"[fatal] task_ids not in suite: {unknown}", file=sys.stderr)
+        return 2
+
+    # Resolve every condition up front so a stimulus mismatch fails before the
+    # GPU bill starts, not 40 minutes in.
+    plan: Dict[int, List[Dict[str, str]]] = {}
+    for task_id in task_ids:
+        task = task_suite.get_task(task_id)
+        plan[task_id] = build_conditions(
+            stimuli,
+            cfg.task_suite_name,
+            task_id,
+            task.language,
+            levels,
+            include_original=not args.no_original,
+            include_empty=not args.no_empty,
+            max_per_level=args.max_per_level,
+        )
+
+    n_cells = sum(len(v) for v in plan.values())
+    n_eps = n_cells * cfg.num_trials_per_task
+    print(f"[plan] suite={cfg.task_suite_name} tasks={len(task_ids)} cells={n_cells} episodes={n_eps}")
+    for task_id in task_ids:
+        print(f"[plan] task {task_id}: {len(plan[task_id])} conditions -> {[c['cond_id'] for c in plan[task_id]]}")
+    if args.dry_run:
+        print("[plan] dry-run: model not loaded, no rollouts executed")
+        return 0
+
+    model, action_head, proprio_projector, noisy_action_projector, processor = initialize_model(cfg)
+    resize_size = get_image_resize_size(cfg)
+
+    os.makedirs(os.path.dirname(os.path.abspath(args.out)), exist_ok=True)
+    n_done = 0
+    t0 = time.time()
+    with open(args.out, "w") as out:
+        for task_id in task_ids:
+            initial_states = task_suite.get_task_init_states(task_id)
+            task = task_suite.get_task(task_id)
+            env, env_task_description = get_libero_env(task, cfg.model_family, resolution=cfg.env_img_res)
+
+            for cond in plan[task_id]:
+                for episode_idx in range(cfg.num_trials_per_task):
+                    # Re-seed per episode from (task, episode) only -- see episode_seed.
+                    s = episode_seed(cfg.seed, task_id, episode_idx)
+                    set_seed_everywhere(s)
+                    random.seed(s)
+                    np.random.seed(s)
+
+                    success, replay_images = run_episode(
+                        cfg,
+                        env,
+                        cond["text"],
+                        model,
+                        resize_size,
+                        processor,
+                        action_head,
+                        proprio_projector,
+                        noisy_action_projector,
+                        initial_states[episode_idx],
+                        None,
+                    )
+                    steps = len(replay_images)
+                    row = {
+                        "suite": cfg.task_suite_name,
+                        "task_id": task_id,
+                        "env_task_description": env_task_description,
+                        "cond_id": cond["cond_id"],
+                        "level": cond["level"],
+                        "op": cond["op"],
+                        "instruction": cond["text"],
+                        "episode_idx": episode_idx,
+                        "episode_seed": s,
+                        "success": bool(success),
+                        "steps": steps,
+                        # A failure at the cap did not "fail" so much as never
+                        # finish; the AMLC run found every failure sitting at the
+                        # cap, so record it instead of inferring it later.
+                        "hit_step_cap": (not success) and steps >= max_steps,
+                        "max_steps": max_steps,
+                    }
+                    out.write(json.dumps(row) + "\n")
+                    out.flush()
+
+                    keep = args.save_videos == "all" or (args.save_videos == "failures" and not success)
+                    if keep:
+                        tag = f"{task_id}-{cond['cond_id'].replace('/', '_')}"
+                        save_rollout_video(
+                            replay_images, n_done, success=success, task_description=tag, log_file=None
+                        )
+
+                    n_done += 1
+                    if n_done % 10 == 0:
+                        rate = (time.time() - t0) / n_done
+                        print(f"[prog] {n_done}/{n_eps} eps  {rate:.1f}s/ep  eta {(n_eps - n_done) * rate / 60:.0f}m")
+
+            env.close()
+
+    print(f"[done] {n_done} episodes -> {args.out} in {(time.time() - t0) / 60:.1f}m")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
